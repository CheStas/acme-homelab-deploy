# Certificate paths (from acme.sh)
CERT_DIR="$HOME/certs/internal.domain.net"

# TrueNAS API key (generate in TrueNAS UI > API Keys)
TRUENAS_API_KEY="your-truenas-api-key-here"
TRUENAS_URL="https://192.168.1.1"

# Nginx Proxy Manager
NPM_PASSWORD="your-npm-password-here"
NPM_URL="http://192.168.1.1:30020"
NPM_EMAIL="email"
NPM_DOMAINS="domain"

# Wikihome / Node-RED
WIKIHOME_HOST="192.168.1.1"
WIKIHOME_USER="user"