# Certificate paths (from acme.sh)
CERT_FILE="fullchain.pem"
KEY_FILE="privkey.pem"

# SSH
SSH_KEY="$HOME/.ssh/id_acme_deploy"

# Home Assistant
HA_HOST="homeassistant.internal"
HA_USER="root"
HA_CERT_DIR="/ssl"

# TrueNAS
TRUENAS_CERT_PREFIX="wildcard_internal"

# Wikihome / Node-RED
WIKIHOME_CERT_DIR="/etc/nodered/certs"
WIKIHOME_RESTART_CMD="sudo systemctl restart nodered"

# Curl defaults
CURL_TIMEOUT=30
CURL_MAX_TIME=120
